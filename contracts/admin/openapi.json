                "all",
                "real",
                "demo"
              ],
              "type": "string",
              "default": "real",
              "title": "Scope"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10000,
              "minimum": 0,
              "default": 0,
              "title": "Page"
            }

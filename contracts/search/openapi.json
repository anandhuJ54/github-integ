          "status"
        ],
        "title": "Assign"
      },
      "Batch": {
        "properties": {
          "batch": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Batch"
          }
        },
        "type": "object",
        "required": [
          "batch"
        ],
        "title": "Batch"
      },

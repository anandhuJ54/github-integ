# Template for surface-api/.env (setup.sh copies it there if .env is missing).
# Placeholder values only: put the real ones in .env, from the team's secret store.
# Never commit .env.

# --- required ---
# Postgres. The login must be allowed to switch to the anon, authenticated and service_role roles.
DATABASE_URL=postgresql://my_user:my_password@db.example.internal:5432/postgres
# Supabase project; the API checks login tokens against its keys.
SUPABASE_URL=https://abcdefghijkl.supabase.co

# --- recommended ---
# DB connections per API process (default 10); stay under your login's connection limit.
DB_POOL_MAX=4

# --- optional ---
# SUPABASE_JWT_SECRET=only-if-the-project-signs-tokens-with-HS256
# DATABASE_READ_URL=postgresql://my_user:my_password@replica.example.internal:5432/postgres
# CORS_ALLOW_ORIGINS=https://app.example.com
# SITE_ORIGIN=https://www.example.com

# --- local sign-in against a local database (off unless LOCAL_AUTH_ENABLED is on) ---
# LOCAL_AUTH_ENABLED=0
# At least 32 random bytes. Generate your own; never reuse a Supabase secret.
# LOCAL_AUTH_JWT_SECRET=
# LOCAL_AUTH_TOKEN_HOURS=8
# SRP_LOCAL_SCHEMA=srp_cleanup
# Test password the seed (surfaces.srp.auth.seed) sets on the mock users.
# SRP_SEED_PASSWORD=

# --- only for the features that use them ---
# ANTHROPIC_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# CLAIM_OTP_SECRET=
# RESEND_API_KEY=
# DEV_REPORT_CRON_SECRET=
# DISCO_WORKER_KEY=
# DISCO_MODEL=
# OXYLABS_USERNAME=
# OXYLABS_PASSWORD=

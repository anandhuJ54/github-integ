# Template for surface-ui/.env (setup.sh copies it there if .env is missing).
# Placeholder values only: put the real ones in .env. Never commit .env.

# --- required ---
VITE_SUPABASE_URL=https://abcdefghijkl.supabase.co
# The project's public (anon) key.
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-the-publishable-key

# --- optional ---
# Where the dev server forwards /api (default http://localhost:8000).
# API_PROXY_TARGET=http://localhost:8000
# The API base the browser calls (default /api).
# VITE_API_BASE_URL=/api
